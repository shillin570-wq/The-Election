# VITE_API_BASE_URL: Optional frontend API base URL.
# On Vercel (frontend + api in one project), keep empty.
# If frontend and backend are split, set to backend URL.
VITE_API_BASE_URL=""

# CORS_ORIGIN: Optional allowlist for cross-origin API requests.
# Comma-separated origins, for example:
# CORS_ORIGIN="https://your-frontend.vercel.app,https://example.com"
# Leave empty to allow all origins.
CORS_ORIGIN=""
